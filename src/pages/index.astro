---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EmailCard from '../components/EmailCard.astro';
import Search from '../components/Search.astro';

const emails = await getCollection('emails');

// Sort by date descending (newest first)
emails.sort((a, b) => {
  const da = new Date(a.data.date);
  const db = new Date(b.data.date);
  return db.getTime() - da.getTime();
});

// Extract unique years from emails
const years = [...new Set(
  emails.map((e) => {
    const d = new Date(e.data.date);
    return isNaN(d.getTime()) ? null : d.getFullYear();
  }).filter(Boolean)
)].sort((a, b) => b - a);

// Build a year for each email (for data attribute)
function getYear(dateStr: string): number | null {
  const d = new Date(dateStr);
  return isNaN(d.getTime()) ? null : d.getFullYear();
}
---
<Base title="Home">
  <Search />

  <nav class="year-nav" aria-label="Filter by year">
    <button class="year-btn active" data-year="all">All</button>
    {years.map((year) => (
      <button class="year-btn" data-year={year}>{year}</button>
    ))}
  </nav>

  <ul class="email-list" id="email-list">
    {emails.map((email) => (
      <li data-year={getYear(email.data.date)}>
        <EmailCard
          slug={email.id}
          subject={email.data.subject}
          date={email.data.date}
          listingCount={email.data.listingCount}
        />
      </li>
    ))}
  </ul>
</Base>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.year-btn');
    const items = document.querySelectorAll('#email-list li');
    const yearNav = document.querySelector('.year-nav');
    const emailList = document.getElementById('email-list');
    const searchInput = document.querySelector('.pagefind-ui__search-input');

    // Year filtering
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const year = btn.dataset.year;
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        items.forEach((li) => {
          li.style.display = (year === 'all' || li.dataset.year === year) ? '' : 'none';
        });
      });
    });

    // Hide email list when search is active
    // Pagefind creates the input dynamically, so watch for it
    const searchContainer = document.getElementById('search');
    if (searchContainer) {
      const setupToggle = (input) => {
        const toggle = () => {
          const hasQuery = input.value.trim().length > 0;
          yearNav.style.display = hasQuery ? 'none' : '';
          emailList.style.display = hasQuery ? 'none' : '';
        };
        input.addEventListener('input', toggle);
        input.addEventListener('change', toggle);
        toggle();
      };

      // Watch for Pagefind to inject its input
      new MutationObserver((_, obs) => {
        const input = searchContainer.querySelector('input[type="text"]');
        if (input) {
          setupToggle(input);
          obs.disconnect();
        }
      }).observe(searchContainer, { childList: true, subtree: true });
    }
  });
</script>
